#include "mediainfom.h"
#include <QFile>
#include <QFileInfo>
#include <QDebug>
#include <QImage>
#include <QMap>

MediaInfoM::MediaInfoM(QObject *parent) : QObject(parent)
{
}

// Box reading
QString MediaInfoM::readStringDataBox(QFile &file, qint64 boxEnd)
{
    // Skip 8 bytes header in data box (flags + reserved)
    file.seek(file.pos() + 8);
    qint64 dataSize = boxEnd - file.pos();
    if (dataSize <= 0)
        return QString();

    QByteArray data = file.read(dataSize);
    return QString::fromUtf8(data).remove(QChar('\0')).trimmed();
}

bool MediaInfoM::readBoxHeader(QFile &file, Mp4Box &box)
{
    if (file.bytesAvailable() < 8)
        return false;

    QByteArray sizeData = file.read(4);
    QByteArray typeData = file.read(4);

    quint32 size32 = (quint8(sizeData[0]) << 24) | (quint8(sizeData[1]) << 16) | (quint8(sizeData[2]) << 8) | quint8(sizeData[3]);
    quint64 size = size32;

    box.type = typeData;
    box.headerSize = 8;

    if (size == 0) {
        // box extends to end of file
        size = file.size() - file.pos() + 8; // +8 to include header itself
    } else if (size == 1) {
        QByteArray size64Data = file.read(8);
        if (size64Data.size() < 8)
            return false;
        size = 0;
        for (int i = 0; i < 8; ++i)
            size = (size << 8) | quint8(size64Data[i]);
        box.headerSize += 8;
    }

    if (size < box.headerSize) {
        emit errorOccurred(QString("Invalid box size detected: %1 < %2").arg(size).arg(box.headerSize));
        return false;
    }

    box.size = size;
    box.dataPos = file.pos();

    qDebug() << "Box type:" << QString::fromUtf8(box.type) << "Size:" << size << "HeaderSize:" << box.headerSize << "DataPos:" << box.dataPos;

    return true;
}

bool MediaInfoM::findCoverBox(QFile &file, qint64 endPos, QByteArray &coverData)
{
    while (file.pos() < endPos) {
        Mp4Box box;
        if (!readBoxHeader(file, box))
            return false;

        qint64 boxEnd = file.pos() + box.size - box.headerSize;
        QString boxType = QString::fromUtf8(box.type);

        if (boxType == "covr") {
            // Within covr there is often a 'data' box containing image data.
            while (file.pos() < boxEnd) {
                Mp4Box innerBox;
                if (!readBoxHeader(file, innerBox))
                    break;

                QString innerType = QString::fromUtf8(innerBox.type);
                qint64 innerEnd = file.pos() + innerBox.size - innerBox.headerSize;

                if (innerType == "data") {
                    // Skip the first 8 byes (4 Byte Flags + 4 Byte Reserved)
                    file.seek(file.pos() + 8);
                    qint64 dataSize = innerEnd - file.pos();
                    coverData = file.read(dataSize);
                    return true;
                } else {
                    file.seek(innerEnd);
                }
            }
            return false;
        }
        else if (boxType == "ilst" || boxType == "meta" || boxType == "moov" || boxType == "udta") {
            if (boxType == "meta") {
                file.seek(file.pos() + 4); // Sikp version/flags
            }
            if (findCoverBox(file, boxEnd, coverData))
                return true;
            file.seek(boxEnd);
        } else {
            file.seek(boxEnd);
        }
    }
    return false;
}

void MediaInfoM::parseBoxes(QFile &file, qint64 endPos, const std::function<void(const Mp4Box &, QFile &)> &visitor)
{
    while (file.pos() < endPos) {
        Mp4Box box;
        qint64 startPos = file.pos();

        if (!readBoxHeader(file, box))
            break;

        // Calculate box end position
        qint64 boxEnd = startPos + box.size;

        // Clamp boxEnd to file size and given endPos
        if (boxEnd > endPos)
            boxEnd = endPos;
        if (boxEnd > file.size())
            boxEnd = file.size();

        // Prevent infinite loops by checking box size and positions
        if (box.size < box.headerSize || boxEnd <= startPos) {
            emit errorOccurred("Box size or position invalid, aborting parsing");
            break;
        }

        visitor(box, file);

        // Move to the end of the current box for next iteration
        if (!file.seek(boxEnd)) {
            emit errorOccurred("Failed to seek to box end");
            break;
        }
    }
}

// ???
QString MediaInfoM::detectFileType(const QString &filePath)
{
    QString suffix = QFileInfo(filePath).suffix().toLower();
    return suffix;
}

QMap<QString, QString> MediaInfoM::extractMetadata(const QString &filePath)
{
    QString fileType = detectFileType(filePath);

    if (fileType == "mp4" || fileType == "m4v") {
        return extractMetadataMp4(filePath);
    }
    else if (fileType == "mkv") {
        emit errorOccurred("MKV-Cover-Extraktion noch nicht implementiert");
        //return QMap();
    }
    else if (fileType == "avi") {
        emit errorOccurred("AVI-Cover-Extraktion noch nicht implementiert");
        //return QMap();
    }
    else {
        emit errorOccurred("Unbekanntes oder nicht unterstütztes Format: " + fileType);
        //return QMap();
    }
}

QImage MediaInfoM::extractCoverImage(const QString &filePath)
{
    QString fileType = detectFileType(filePath);

    if (fileType == "mp4" || fileType == "m4v") {
        return extractCoverImageMp4(filePath);
    }
    else if (fileType == "mkv") {
        emit errorOccurred("MKV-Cover-Extraktion noch nicht implementiert");
        return QImage();
    }
    else if (fileType == "avi") {
        emit errorOccurred("AVI-Cover-Extraktion noch nicht implementiert");
        return QImage();
    }
    else {
        emit errorOccurred("Unbekanntes oder nicht unterstütztes Format: " + fileType);
        return QImage();
    }
}

// MP4
QImage MediaInfoM::extractCoverImageMp4(const QString &filePath)
{
    /*
	Opens the file and reads it box by box (MP4 container structure).
	Specifically searches for the `moov` box, then recursively searches for the cover box (`covr`) within it, and finally for the image data (`data`) within that box.
	Correctly skips metadata headers and reads only the raw image bytes.
	Loads the image using `QImage::loadFromData()` and returns the image.
	Reports errors via a signal if the file could not be opened or the cover could not be found/loaded.
    */
    QFile file(filePath);
    if (!file.open(QIODevice::ReadOnly)) {
		// Emit error if file cannot be opened and return an empty QImage
        emit errorOccurred(QString("Cannot open File: %1").arg(filePath));
        return QImage();
    }

    QByteArray coverData;			// Will hold the raw cover image data extracted from the file
    qint64 fileSize = file.size();	// Get total file size to control reading limits

	// Loop over the file to read MP4 boxes (atoms) until end of file
    while (file.pos() < fileSize) {
        Mp4Box box;
        if (!readBoxHeader(file, box))
            break;  // Stop if box header cannot be read (likely EOF or corrupted file)

		// Validate that the box size is at least the size of its header
        if (box.size < box.headerSize) {
            emit errorOccurred("Ungültige Box-Größe gefunden");
            return QImage();
        }
		// Calculate the position where the current box ends
        qint64 boxEnd = file.pos() + box.size - box.headerSize;

		// Prevent seeking beyond file size
        if (boxEnd > fileSize)
            boxEnd = fileSize;
		
		// Convert the 4-byte box type to a QString for easy comparison
        QString boxType = QString::fromUtf8(box.type);

		// We are interested in the 'moov' box, which contains metadata including the cover
        if (boxType == "moov") {
			// Search recursively inside the 'moov' box for the cover data
            if (findCoverBox(file, boxEnd, coverData)) {
                QImage img;
				
                // Try to load the cover image from the raw data bytes
				bool ok = img.loadFromData(coverData);
                if (!ok) {
					// Emit error if the image data could not be loaded as an image
                    emit errorOccurred("Error: JPEG-Daata cannot be loaded.");
                    return QImage();
                }
				
				// Return the loaded QImage (successful cover extraction)
                return img; 
            }
        } else {
			// Skip to the end of the current box if it is not 'moov'
            file.seek(boxEnd);
        }
    }
	// If no cover found after parsing the entire file, emit an error and return empty QImage
	emit errorOccurred(QString("No cover found: %1").arg(filePath));
    return QImage();
}

QMap<QString, QString> MediaInfoM::extractMetadataMp4(const QString &filePath)
{
    QFile file(filePath);
    QMap<QString, QString> metadata;

    if (!file.open(QIODevice::ReadOnly)) {
        emit errorOccurred(QString("Cannot open file: %1").arg(filePath));
        return metadata;
    }

    // Visitor lambda sucht nach typischen Metadaten-Boxen
    std::function<void(const Mp4Box &, QFile &)> metaVisitor = [&](const Mp4Box &box, QFile &file) {
        QString type = QString::fromUtf8(box.type);
        qint64 boxEnd = file.pos() + box.size - box.headerSize;

        if (type == "moov" || type == "udta" || type == "ilst") {
            parseBoxes(file, boxEnd, metaVisitor);
        } else if (type == "meta") {
            file.seek(file.pos() + 4); // Skip version/flags
            parseBoxes(file, boxEnd, metaVisitor);
        } else {
            // Treat as tag box
            QString value = readStringDataBox(file, boxEnd);
            if (!value.isEmpty()) {
                qDebug() << "Metadata tag:" << type << "Value:" << value;
                metadata.insert(type, value);
            }
            file.seek(boxEnd);
        }
    };

    parseBoxes(file, file.size(), metaVisitor);

    if (metadata.isEmpty())
        emit errorOccurred("No metadata found");

    return metadata;
}
