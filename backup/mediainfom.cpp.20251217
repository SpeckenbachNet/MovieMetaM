#include "mediainfom.h"
#include <QDebug>
#include <cstring>
#include <QtEndian>

MediaInfoM::MediaInfoM(QObject *parent) : QObject(parent) {}

quint32 MediaInfoM::boxTypeToUint32(const char boxType[4]) const
{
    // Wandelt die 4 Big-Endian-Bytes in einen quint32 um
    return (quint32(boxType[0]) << 24) |
           (quint32(boxType[1]) << 16) |
           (quint32(boxType[2]) << 8)  |
           (quint32(boxType[3]));
}

// box handling
bool MediaInfoM::findCoverBox(QFile &file, qint64 endPos, QByteArray &coverData)
{
    while (file.pos() < endPos) {
        Mp4Box box;
        if (!readBoxHeader(file, box))
            return false;

        qint64 boxEnd = file.pos() + box.size - box.headerSize;
        QString boxType = QString::fromUtf8(box.type);

        if (boxType == "covr") {
            // Within covr there is often a 'data' box containing image data.
            while (file.pos() < boxEnd) {
                Mp4Box innerBox;
                if (!readBoxHeader(file, innerBox))
                    break;

                QString innerType = QString::fromUtf8(innerBox.type);
                qint64 innerEnd = file.pos() + innerBox.size - innerBox.headerSize;

                if (innerType == "data") {
                    // Skip the first 8 byes (4 Byte Flags + 4 Byte Reserved)
                    file.seek(file.pos() + 8);
                    qint64 dataSize = innerEnd - file.pos();
                    coverData = file.read(dataSize);
                    return true;
                } else {
                    file.seek(innerEnd);
                }
            }
            return false;
        }
        else if (boxType == "ilst" || boxType == "meta" || boxType == "moov" || boxType == "udta") {
            if (boxType == "meta") {
                file.seek(file.pos() + 4); // Sikp version/flags
            }
            if (findCoverBox(file, boxEnd, coverData))
                return true;
            file.seek(boxEnd);
        } else {
            file.seek(boxEnd);
        }
    }
    return false;
}

bool MediaInfoM::readBoxHeader(QFile &file, Mp4Box &box)
{
    if (file.bytesAvailable() < 8)
        return false;

    QByteArray sizeData = file.read(4); // read 4 bytes size
    QByteArray typeData = file.read(4); // read 4 bytes type
    qDebug() << "DEBUG readBoxHeader: Gelesene Größe-Bytes (Hex):" << sizeData.toHex();
    qDebug() << "DEBUG readBoxHeader: Gelesene Typ-Bytes (Hex):" << typeData.toHex();

    //quint32 size32 = (quint8(sizeData[0]) << 24) | (quint8(sizeData[1]) << 16) | (quint8(sizeData[2]) << 8) | quint8(sizeData[3]);
    //quint32 size32 = qFromBigEndian(*reinterpret_cast<const quint32*>(sizeData.constData()));
    // Korrigierte, robuste Endian-Konvertierung:
    quint32 size32;
    // 1. Verwenden Sie die manuelle Bit-Shift-Logik, die in Qt-Dateien üblich ist:
    size32 = (quint8(sizeData[0]) << 24) |
             (quint8(sizeData[1]) << 16) |
             (quint8(sizeData[2]) << 8)  |
             quint8(sizeData[3]);

    quint64 size = size32;

    memcpy(box.type, typeData.data(), 4); // Kopiert 4 Bytes
    box.headerSize = 8;

    if (size == 0) {
        size = file.size() - file.pos() + 8; // box extends to EOF
    } else if (size == 1) {
        QByteArray size64Data = file.read(8);
        if (size64Data.size() < 8)
            return false;
        size = 0;
        for (int i = 0; i < 8; ++i)
            size = (size << 8) | quint8(size64Data[i]);
        box.headerSize += 8;
    }

    if (size < box.headerSize) {
        emit errorOccurred(QString("Invalid box size detected: %1 < %2").arg(size).arg(box.headerSize));
        return false;
    }

    box.size = size;
    box.dataPos = file.pos();
    //qDebug() << "===============================";
    //qDebug() << "Box type:" << QString::fromUtf8(box.type) << "Size:" << size << "HeaderSize:" << box.headerSize << "DataPos:" << box.dataPos;

    return true;
}

void MediaInfoM::parseBoxes(QFile &file, qint64 endPos, const std::function<void(const Mp4Box &, QFile &)> &visitor)
{
    //qDebug() << "--- Entering parseBoxes. StartPos:" << file.pos() << "EndPos:" << endPos;

    while (file.pos() < endPos) {
        Mp4Box box;
        qint64 startPos = file.pos();

        if (!readBoxHeader(file, box))
            break;

        qint64 boxEnd = startPos + box.size;

        // Sanity check, wie zuvor
        if (boxEnd > endPos)
            boxEnd = endPos;
        if (boxEnd > file.size())
            boxEnd = file.size();

        if (box.size < box.headerSize || boxEnd <= startPos) {
            emit errorOccurred("Invalid box size or position, aborting parsing");
            break;
        }

        qint64 posBeforeVisit = file.pos();

        // --- HIER WIRD DIE BOX VERARBEITET ---
        visitor(box, file);

        // --- SICHERHEITS-FALLBACK ---
        // Stellt sicher, dass der Dateiposition am Ende der Box landet.
        if (file.pos() < boxEnd) {
            qDebug() << "WARNING: Visitor did not consume box " << QString::fromUtf8(box.type)
            << ". Forcing seek from" << file.pos() << "to" << boxEnd;
            if (!file.seek(boxEnd)) {
                emit errorOccurred("Failed to seek to box end after visit.");
                break;
            }
        } else if (file.pos() > boxEnd) {
            qDebug() << "ERROR: Visitor exceeded box end. Expected" << boxEnd << ", actual" << file.pos();
            break;
        }
    }
    //qDebug() << "--- Exiting parseBoxes. FinalPos:" << file.pos();
}

// extract funtions for several movie types
QImage MediaInfoM::extractCoverImageMp4(const QString &filePath)
{
    // Extracts the cover image from an MP4 file by searching specifically for the 'moov' box,
    // then recursively finds the 'covr' box and finally the 'data' box containing the image bytes.
    // Returns a QImage of the cover or an empty QImage if none found or on error.
    // Emits errorOccurred signal on failures.
    QFile file(filePath);
    if (!file.open(QIODevice::ReadOnly)) {
        emit errorOccurred(QString("Cannot open file: %1").arg(filePath));
        return QImage();
    }

    QByteArray coverData;           // Buffer for raw cover image data
    qint64 fileSize = file.size();

    // Iterate over MP4 boxes until end of file
    while (file.pos() < fileSize) {
        Mp4Box box;
        if (!readBoxHeader(file, box))
            break;  // Stop on read error or EOF

        if (box.size < box.headerSize) {
            emit errorOccurred("Invalid box size detected");
            return QImage();
        }

        qint64 boxEnd = file.pos() + box.size - box.headerSize;
        if (boxEnd > fileSize)
            boxEnd = fileSize;

        QString boxType = QString::fromUtf8(box.type);

        // The 'moov' box contains metadata including the cover
        if (boxType == "moov") {
            // Recursively search for cover box inside 'moov'
            if (findCoverBox(file, boxEnd, coverData)) {
                QImage img;
                bool ok = img.loadFromData(coverData);
                if (!ok) {
                    emit errorOccurred("Error: Cover image data cannot be loaded.");
                    return QImage();
                }
                return img;  // Successfully loaded cover image
            }
        } else {
            file.seek(boxEnd);  // Skip non-'moov' boxes
        }
    }

    emit errorOccurred(QString("No cover found in file: %1").arg(filePath));
    return QImage();
}

QMap<QString, QString> MediaInfoM::extractMetadataMp4(const QString &filePath)
{
    const quint32 DASH_BOX_NUM = static_cast<quint32>(0x2D2D2D2D); // "----"
    const quint32 UUID_BOX_NUM = static_cast<quint32>(0x75756964); // "uuid"

    // Define numeric Value for tags (big-endian-byte-sequence)
    const QSet<quint32> relevantTagValues = {
        // ©nam = 0xA96E616D
        static_cast<quint32>(0xA96E616D), // ©nam (Title)
        static_cast<quint32>(0xA9415254), // ©ART (Director)
        static_cast<quint32>(0x61415254), // aART (Actors)
        static_cast<quint32>(0xA9616C62), // ©alb (Album)
        static_cast<quint32>(0xA9777274), // ©wrt (Regie???)
        static_cast<quint32>(0xA967656E), // ©gen (Genre)
        static_cast<quint32>(0xA9646179), // ©day (Year)
        static_cast<quint32>(0x64657363), // desc (Description)
        static_cast<quint32>(0x6C646573), // ldes (LongDescription)

        static_cast<quint32>(0x74767368), // tvsh (TV Show - Name of series)
        static_cast<quint32>(0x7476736E), // tves (TV Season)
        static_cast<quint32>(0x74766573), // tves (TV Episode)

        // Sorting Tags mostly not relevant for movies
        static_cast<quint32>(0x736F6E6D), // sonm (Sort Title
        static_cast<quint32>(0x736F6172), // soar (Sort Direction)
        static_cast<quint32>(0x736F6161), // soaa (Sort Actors)
        static_cast<quint32>(0x736F616C), // soal (Sort Album)
        static_cast<quint32>(0x736F636F), // soco (
    };

    QFile file(filePath);
    QMap<QString, QString> metadata;

    if (!file.open(QIODevice::ReadOnly)) {
        emit errorOccurred(QString("Cannot open file: %1").arg(filePath));
        return metadata;
    }

    // Visitor callback invoked for each box found during parsing
    std::function<void(const Mp4Box &, QFile &)> metaVisitor =
        [&](const Mp4Box &box, QFile &file)
    {
            // 1. Box-Typ in numerischen Wert konvertieren
        quint32 boxTypeNum = boxTypeToUint32(box.type);
        QString type = QString::fromUtf8(box.type); // Beibehalten für Debug-Ausgabe

        //qDebug() << "Visiting box type:" << type;
        bool isRelevantTag = relevantTagValues.contains(boxTypeNum);
        //qDebug() << "Checking if type is relevant:" << isRelevantTag;

        // boxEnd ist das absolute Ende der Daten dieser Box
        qint64 currentPos = file.pos();
        qint64 boxDataEnd = currentPos + box.size - box.headerSize;

        // Parse container box recursive
        // -------------------------------------------------------------
        // 1. Parse container box recursive
        // -------------------------------------------------------------
        if (type == "moov" || type == "trak" || type == "udta" || type == "meta" || type == "ilst" || type == "covr")
        {
            // 'meta' box has 4-Byte header (version/flags), which must be skipped
            if (type == "meta") {
                //qDebug() << "Skipping meta version/flags at" << file.pos();
                file.seek(file.pos() + 4);
            }

            //qDebug() << "ENTER RECURSION into" << type << "at" << file.pos();
            parseBoxes(file, boxDataEnd, metaVisitor);
        }
        // -------------------------------------------------------------
        // 2. Special case: XMP/UUID
        // -------------------------------------------------------------
        else if (boxTypeNum == UUID_BOX_NUM) {
            readXmpData(file, boxDataEnd, metadata);
        }
        // -------------------------------------------------------------
        // 3. SPECIAL CASE: ---- (Proprietärer Tag-Container)
        // -------------------------------------------------------------
        else if (boxTypeNum == DASH_BOX_NUM) {

            // SPEICHERE DIE ANFANGSPOSITION DER DATEN (ANFANG DER 'data'-Box)
            const qint64 dataBoxStartPos = file.pos();
            qDebug() << "DEBUG: Saved start position:" << dataBoxStartPos;

            // 1. Lese 'mean' und 'name', um den Key zu bestimmen.
            // readProprietaryKey setzt den Zeiger ans Ende der 'name'-Box,
            // wir müssen ihn manuell zurücksetzen.
            QString key = readProprietaryKey(file, boxDataEnd);

            // -------------------------------------------------------------
            // >>> SCHNELLE PRÜFUNG HIER EINFÜGEN <<<
            // -------------------------------------------------------------
            qDebug() << "metaVisitor (----): Proprietärer Schlüssel gefunden:" << key;
            qDebug() << "metaVisitor (----): Zeiger vor Zurücksetzung:" << file.pos();

            // 2. Setze den Zeiger zurück zum Anfang des Datenblocks (Anfang der data-Box)
            // Dies ist notwendig, damit readStringDataBox korrekt die data-Box liest.
            file.seek(dataBoxStartPos);

            qDebug() << "metaVisitor (----): Zeiger nach Zurücksetzung (Sollte dataBoxStartPos sein):" << file.pos();

            if (!key.isEmpty()) {
                // 3. Lese die 'data'-Box mit dem gefundenen proprietären Key
                readStringDataBox(file, key, metadata, boxDataEnd);
            } else {
                // Wenn kein Name gefunden wurde, überspringen wir den ganzen Block.
                file.seek(boxDataEnd);
            }
        }
        // -------------------------------------------------------------
        // 4. Metadata tag boxes (text/mumber)
        // -------------------------------------------------------------
        else if (relevantTagValues.contains(boxTypeNum))
        {
            QString key = "";

            // Hier alle Zuordnungen von boxTypeNum zu Key einfügen
            if (boxTypeNum == static_cast<quint32>(0xA96E616D)) key = "Title";
            else if (boxTypeNum == static_cast<quint32>(0xA9415254)) key = "Artist";
            else if (boxTypeNum == static_cast<quint32>(0x61415254)) key = "AlbumArtist";
            else if (boxTypeNum == static_cast<quint32>(0xA9616C62)) key = "Album";
            else if (boxTypeNum == static_cast<quint32>(0xA9777274)) key = "Composer";
            else if (boxTypeNum == static_cast<quint32>(0xA967656E)) key = "Genre";
            else if (boxTypeNum == static_cast<quint32>(0xA9646179)) key = "Year";
            else if (boxTypeNum == static_cast<quint32>(0x64657363)) key = "Description";
            else if (boxTypeNum == static_cast<quint32>(0x6C646573)) key = "LongDescription";

            else if (boxTypeNum == static_cast<quint32>(0x736F6E6D)) key = "SortTitle";
            else if (boxTypeNum == static_cast<quint32>(0x736F6172)) key = "SortArtist";
            else if (boxTypeNum == static_cast<quint32>(0x736F6161)) key = "SortAlbumArtist";
            else if (boxTypeNum == static_cast<quint32>(0x736F616C)) key = "SortAlbum";
            else if (boxTypeNum == static_cast<quint32>(0x736F636F)) key = "SortComposer";

            if (!key.isEmpty()) {
                // Liest die nachfolgende 'data'-Box und setzt den Zeiger korrekt
                readStringDataBox(file, key, metadata, boxDataEnd);
            }
            else {
                // Wenn wir eine relevante Box finden, die wir aber nicht zuordnen können,
                // müssen wir sie überspringen, um nicht im Dateizeiger stecken zu bleiben.
                file.seek(boxDataEnd);
            }
        }
        // -------------------------------------------------------------
        // 5. GENERIC SKIP (Überspringt alle anderen UNBEKANNTEN Boxen, wie z.B. 'data' wenn alleinstehend)
        // -------------------------------------------------------------
        else {
            if (file.pos() != boxDataEnd) {
                file.seek(boxDataEnd);
            }
        }
    };

    parseBoxes(file, file.size(), metaVisitor);

    if (metadata.isEmpty())
        emit errorOccurred("No metadata found");

    return metadata;
}

// Read functions
QString MediaInfoM::readProprietaryKey(QFile &file, qint64 parentBoxEnd) {
    QString key = "";
    qint64 startPos = file.pos();
    const quint8 BOX_HEADER_SIZE = 8;

    // 1. Erster Versuch: Struktur-basiertes Parsen
    file.seek(startPos + 4); // Skip Version/Flags

    while (file.pos() < parentBoxEnd) {
        if (file.bytesAvailable() < BOX_HEADER_SIZE) break;
        qint64 currentPos = file.pos();

        QByteArray type = file.read(4);
        quint32 size = 0;
        QDataStream s(file.read(4)); // Größe lesen
        s >> size;

        // Wenn wir eine 'name'-Box finden, ist das der Jackpot (Standard-Weg)
        if (type == "name" && size >= 8 && (currentPos + size) <= parentBoxEnd) {
            key = QString::fromUtf8(file.read(size - 8));
            file.seek(parentBoxEnd);
            return key;
        }

        // Falls unplausibel (wie in deinen Dateien), springen wir nur 1 Byte weiter
        // und versuchen es erneut (Byte-Scanning wie ffprobe)
        file.seek(currentPos + 1);

        // Notbremse, damit wir nicht ewig suchen
        if (file.pos() > startPos + 100) break;
    }

    // --- FALLBACK: DEEP SCAN (Die "ffprobe"-Methode) ---
    if (key.isEmpty()) {
        file.seek(startPos);
        QByteArray buffer = file.read(parentBoxEnd - startPos);

        // Suche nach dem Namen in den Rohdaten
        if (buffer.contains("iTunMOVI")) {
            key = "iTunMOVI";
        } else if (buffer.contains("iTunEXTC")) {
            key = "iTunEXTC";
        }
    }

    file.seek(parentBoxEnd);
    return key;
}

QString MediaInfoM::readStringDataBox(QFile &file, qint64 parentBoxEnd, const QString &tagName) {
    // 1. Wir sichern uns den gesamten Bereich des Containers
    qint64 currentPos = file.pos();
    qint64 remainingBytes = parentBoxEnd - currentPos;

    if (remainingBytes <= 0) return "";

    // 2. Den gesamten Container-Rest in einen Puffer laden
    QByteArray buffer = file.read(remainingBytes);

    // 3. Speziell für iTunMOVI: Suche nach XML-Signatur
    if (tagName == "iTunMOVI" || tagName == "iTunEXTC") {
        int xmlStart = buffer.indexOf("<?xml");
        if (xmlStart == -1) xmlStart = buffer.indexOf("<plist"); // Fallback falls Header fehlt

        if (xmlStart != -1) {
            int xmlEnd = buffer.lastIndexOf("</plist>");
            if (xmlEnd != -1 && xmlEnd > xmlStart) {
                // Wir nehmen den Block von < bis >
                xmlEnd += 8; // Länge von "</plist>"
                QByteArray xmlData = buffer.mid(xmlStart, xmlEnd - xmlStart);
                qDebug() << "DEBUG: XML-Inhalt über Signatur-Suche gefunden!";
                return QString::fromUtf8(xmlData);
            }
        }
    }

    // 4. Fallback für normale Tags oder falls kein XML gefunden wurde:
    // Suche nach der klassischen 'data' Box innerhalb des Puffers
    int dataIdx = buffer.indexOf("data");
    if (dataIdx >= 4) {
        // Die Größe steht 4 Bytes vor "data"
        quint32 dSize = (quint8(buffer[dataIdx-4]) << 24) | (quint8(buffer[dataIdx-3]) << 16) |
                        (quint8(buffer[dataIdx-2]) << 8)  | quint8(buffer[dataIdx-1]);

        // iTunes 'data' Boxen haben nach dem Typ "data" noch 8 Bytes Flags/Reserved
        int payloadStart = dataIdx + 4 + 8;
        int payloadSize = dSize - 8 - 8; // Size - Header - Flags

        if (payloadStart + payloadSize <= buffer.size()) {
            return QString::fromUtf8(buffer.mid(payloadStart, payloadSize));
        }
    }

    return "";
}

void MediaInfoM::readXmpData(QFile &file, qint64 boxDataEnd, QMap<QString, QString> &metadata)
{
    qint64 currentPos = file.pos();

    // Die XMP-Datenbox (uuid) besteht aus: 16 Bytes UUID + XML-Daten
    const qint64 uuidSize = 16;

    if (currentPos + uuidSize > boxDataEnd) {
        qDebug() << "readXmpData: Box size too small to contain UUID.";
        file.seek(boxDataEnd); // Korrektur, falls Pointer zu weit ist
        return;
    }

    // 1. UUID lesen (16 Bytes)
    QByteArray uuid = file.read(uuidSize);

    // Standard-XMP-UUID: 89744C68-8849-4002-A819-B7D8D85F8E56
    // Die Box enthält die Bytes ohne Bindestriche (Big-Endian)
    QByteArray xmpUuid = QByteArray::fromHex("89744C6888494002A819B7D8D85F8E56");

    if (uuid == xmpUuid) {
        qDebug() << "XMP: Standard XMP UUID gefunden. Lese XML-Daten...";

        // 2. Restliche Daten lesen (XML-Struktur)
        qint64 xmlDataSize = boxDataEnd - file.pos();

        if (xmlDataSize > 0) {
            QByteArray xmlData = file.read(xmlDataSize);
            QString xmlString = QString::fromUtf8(xmlData);

            qDebug() << "XML Data: " << xmlString;
            // OPTION 1: XML-Daten als Roh-String speichern (empfohlen als erster Schritt)
            //metadata.insert("XMP_RAW_XML", xmlString);

            qDebug() << "XMP: XML-Daten erfolgreich ausgelesen (" << xmlDataSize << " Bytes).";

            // HINWEIS: Hier müsste später die Logik zum Parsen der XML-Struktur (mit QXmlStreamReader) folgen.

        } else {
            qDebug() << "XMP: UUID gefunden, aber keine XML-Daten vorhanden.";
        }
    } else {
        qDebug() << "XMP: uuid Box gefunden, aber keine XMP Standard UUID (" << uuid.toHex() << "). Überspringe.";
    }

    // 3. Unbedingte Zeigerkorrektur
    if (file.pos() != boxDataEnd) {
        if (!file.seek(boxDataEnd)) {
            qDebug() << "XMP: FATAL: Failed to seek to box end" << boxDataEnd << ". Parser might fail.";
        }
    }
}

// extract function with filetype detect
QString MediaInfoM::detectFileType(const QString &filePath)
{
    QString suffix = QFileInfo(filePath).suffix().toLower();
    return suffix;
}

QMap<QString, QString> MediaInfoM::extractMetadata(const QString &filePath)
{
    QString fileType = detectFileType(filePath);

    if (fileType == "mp4" || fileType == "m4v") {
        return extractMetadataMp4(filePath);
    }
    else if (fileType == "mkv") {
        emit errorOccurred("MKV-Cover-Extraktion noch nicht implementiert");
        //return QMap();
    }
    else if (fileType == "avi") {
        emit errorOccurred("AVI-Cover-Extraktion noch nicht implementiert");
        //return QMap();
    }
    else {
        emit errorOccurred("Unbekanntes oder nicht unterstütztes Format: " + fileType);
        //return QMap();
    }
}

QImage MediaInfoM::extractCoverImage(const QString &filePath)
{
    QString fileType = detectFileType(filePath);

    if (fileType == "mp4" || fileType == "m4v") {
        return extractCoverImageMp4(filePath);
    }
    else if (fileType == "mkv") {
        emit errorOccurred("MKV-Cover-Extraktion noch nicht implementiert");
        return QImage();
    }
    else if (fileType == "avi") {
        emit errorOccurred("AVI-Cover-Extraktion noch nicht implementiert");
        return QImage();
    }
    else {
        emit errorOccurred("Unbekanntes oder nicht unterstütztes Format: " + fileType);
        return QImage();
    }
}


