<RCC>
    <!-- Help texts (Markdown) per language of the app: help/<code>/<topic>.md (a topic without a text: English) -->
    <qresource prefix="/help">
        <file alias="de/movielist.md">help/de/movielist.md</file>
        <file alias="en/movielist.md">help/en/movielist.md</file>
        <file alias="de/movieinfo.md">help/de/movieinfo.md</file>
        <file alias="en/movieinfo.md">help/en/movieinfo.md</file>
        <file alias="de/moviesearch.md">help/de/moviesearch.md</file>
        <file alias="en/moviesearch.md">help/en/moviesearch.md</file>
        <file alias="de/saving.md">help/de/saving.md</file>
        <file alias="en/saving.md">help/en/saving.md</file>
        <file alias="de/settings.md">help/de/settings.md</file>
        <file alias="en/settings.md">help/en/settings.md</file>
        <file alias="de/about.md">help/de/about.md</file>
        <file alias="en/about.md">help/en/about.md</file>
        <file alias="fr/movielist.md">help/fr/movielist.md</file>
        <file alias="fr/movieinfo.md">help/fr/movieinfo.md</file>
        <file alias="fr/moviesearch.md">help/fr/moviesearch.md</file>
        <file alias="fr/saving.md">help/fr/saving.md</file>
        <file alias="fr/settings.md">help/fr/settings.md</file>
        <file alias="fr/about.md">help/fr/about.md</file>
        <file alias="es/movielist.md">help/es/movielist.md</file>
        <file alias="es/movieinfo.md">help/es/movieinfo.md</file>
        <file alias="es/moviesearch.md">help/es/moviesearch.md</file>
        <file alias="es/saving.md">help/es/saving.md</file>
        <file alias="es/settings.md">help/es/settings.md</file>
        <file alias="es/about.md">help/es/about.md</file>
    </qresource>
</RCC>
